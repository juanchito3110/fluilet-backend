# Generate both secrets locally. Never commit .env.
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://fluilet:REPLACE_PASSWORD@localhost:5432/fluilet
BCRYPT_ROUNDS=13
CORS_ORIGINS=["http://localhost"]
MT5_MODEL=google/mt5-small
MT5_CHECKPOINT=
MT5_LOCAL_FILES_ONLY=true
MT5_ENABLED=true
ALLOW_RULE_BASED_FALLBACK=true
MT5_MAX_INPUT_TOKENS=4096
PROCESSING_CONCURRENCY=2
INSTALL_ML=false

WIKIPEDIA_ENABLED=true
WIKIPEDIA_TIMEOUT_SECONDS=3.5

# Academic startup accounts; disable outside the demonstration environment.
DEMO_ACCOUNTS_ENABLED=true

# Local development keeps the academic passwords; container production requires
# DEMO_TUTOR_PASSWORD and DEMO_MASTER_PASSWORD with private values.
DEPLOYMENT_ENV=development
# RANKER_CHECKPOINT=/srv/fluilet/checkpoints/context-ranker-v2.1/model.json
# RANKER_CHECKPOINT_SHA256=<sha256-of-the-released-json>

# Password recovery. Gmail uses an app password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Fluilet Soporte"
# Empty credentials: development logs codes; production logs only a configuration error.

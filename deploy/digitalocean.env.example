# Copy to .env in the server checkout and replace every placeholder.
DEPLOYMENT_ENV=production
SECRET_KEY=replace-with-a-private-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-private-database-password
# Use the same database password, URL-encoded here. The container hostname is db.
DATABASE_URL=postgresql+psycopg://fluilet:replace-with-url-encoded-database-password@db:5432/fluilet
DEMO_ACCOUNTS_ENABLED=true
DEMO_TUTOR_PASSWORD=replace-with-a-private-tutor-password
DEMO_MASTER_PASSWORD=replace-with-a-private-master-password
RANKER_CHECKPOINT=/srv/fluilet/checkpoints/context-ranker-v2.3/model.json
MT5_ENABLED=false
INSTALL_ML=false
WIKIPEDIA_ENABLED=true
CORS_ORIGINS=["https://your-domain.example"]
# Optional: pin the actual SHA-256 from checkpoints/retraining_metrics.json.
# RANKER_CHECKPOINT_SHA256=<actual-64-character-sha256>

# Password recovery. Gmail uses an app password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Fluilet Soporte"
# Empty credentials: development logs codes; production logs only a configuration error.
